# ---- Server ----
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080

# ---- Database ----
MONGODB_URI=mongodb+srv://ds-arcade:ds-arcade@cluster0.ia0v8h3.mongodb.net/ds-arcade?appName=Cluster0

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Pricing ----
BASE_PRICE_LKR=1500

# ---- PayHere (used for LKR checkout, Sri Lankan cards) ----
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret
PAYHERE_MODE=sandbox

# ---- Stripe (used for USD/EUR/GBP/etc. checkout for customers outside Sri Lanka) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Test activation (admin/dev use only) ----
TEST_ACTIVATE_CODE=DSARCADE
