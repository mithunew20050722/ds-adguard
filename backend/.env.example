# ---- Server ----
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080

# ---- Database ----
# Paste the MongoDB connection string you get from Atlas (or your own server) here
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/private-dns-adguard?retryWrites=true&w=majority

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Pricing ----
# Base price of adding one device, in LKR. Everything else is converted from this.
BASE_PRICE_LKR=1500

# ---- PayHere (used for LKR checkout, Sri Lankan cards) ----
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret
PAYHERE_MODE=sandbox
# sandbox = https://sandbox.payhere.lk/pay/checkout
# live    = https://www.payhere.lk/pay/checkout

# ---- Stripe (used for USD/EUR/GBP/etc. checkout for customers outside Sri Lanka) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Test activation / link reveal password ----
# The password prompt shown right after generating a device's link (Copy +
# OK screen) checks against this exact value. Leave blank to disable —
# then the link can never be revealed, so set it before going live.
TEST_ACTIVATE_CODE=

# ---- Admin panel (/admin.html) ----
# Password-only gate for the store owner's admin panel — no separate account
# needed. Defaults to Nimesha00@@ if you don't set this, so it works with zero
# setup. Change it here (and in Vercel's env vars) whenever you like.
ADMIN_PASSWORD=Nimesha00@@

# ---- Your free domain (from eu.org) ----
# Every device's link looks like: <token>.BASE_DOMAIN
BASE_DOMAIN=nmdandds.eu.org

# ---- DoT proxy connection (Oracle Cloud VM running dot-proxy/) ----
# Shared secret the proxy uses to call POST /api/devices/internal/heartbeat.
# Must be the EXACT same value on the Oracle VM's .env.
INTERNAL_API_TOKEN=change_this_to_a_long_random_string

# After how many minutes without a heartbeat a device shows as "disconnected"
# (computed on read — no background job needed, works fine on Vercel).
DISCONNECT_AFTER_MINUTES=3
